# Copie para .env para rodar no computador. Na Vercel, cadastre em Settings › Environment Variables.

# Banco (Neon). Na Vercel, a integração com o Neon cria estas variáveis sozinha.
DATABASE_URL="postgresql://usuario:senha@servidor/liga?sslmode=require"
# Conexão sem "pooler", usada só nas migrações (opcional; o Neon cria DATABASE_URL_UNPOOLED)
DIRECT_URL=""

# Login (texto aleatório e longo) e endereço do site
NEXTAUTH_SECRET="troque-por-um-texto-aleatorio-e-longo"
NEXTAUTH_URL="http://localhost:3000"

# Primeiro administrador, criado na primeira publicação (troque a senha no primeiro acesso)
SEED_ADMIN_EMAIL="voce@exemplo.com"
SEED_ADMIN_NAME="Seu nome"
SEED_DEFAULT_PASSWORD="SenhaProvisoria2026"

# Mapas e plantas (Vercel Blob). Na Vercel, a integração cria esta variável sozinha.
# Sem ela, no computador, os arquivos vão para a pasta ./storage/uploads
BLOB_READ_WRITE_TOKEN=""
